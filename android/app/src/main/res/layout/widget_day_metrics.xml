<?xml version="1.0" encoding="utf-8"?>
<!-- 4×2 — Day page second tile: in range, mean, below, above -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="1dp"
    android:background="@drawable/widget_background_metrics">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/widget_cell_surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In range"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textSize="9.5sp"
                android:textColor="#707C91"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/widget_tir_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:textColor="#15213B"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_tir_suffix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="13sp"
                    android:textColor="#15213B"
                    android:includeFontPadding="false"
                    android:layout_marginStart="1dp"
                    android:layout_marginBottom="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_tir_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3.9–10.0"
                android:textSize="10sp"
                android:textColor="#707C91"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E3E7ED" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/widget_cell_surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mean"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textSize="9.5sp"
                android:textColor="#707C91"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <TextView
                android:id="@+id/widget_mean_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="#15213B"
                android:includeFontPadding="false"
                android:layout_marginTop="3dp"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mmol/L"
                android:textSize="10sp"
                android:textColor="#707C91"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E3E7ED" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/widget_cell_surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Below 3.9"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textSize="9.5sp"
                android:textColor="#707C91"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/widget_below_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:textColor="#C2255C"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_below_suffix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="13sp"
                    android:textColor="#C2255C"
                    android:includeFontPadding="false"
                    android:layout_marginStart="1dp"
                    android:layout_marginBottom="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_below_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="under 3.0"
                android:textSize="10sp"
                android:textColor="#C2255C"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:maxLines="1" />
        </LinearLayout>

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E3E7ED" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/widget_cell_surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Above 10.0"
                android:textAllCaps="true"
                android:letterSpacing="0.1"
                android:textSize="9.5sp"
                android:textColor="#707C91"
                android:includeFontPadding="false"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/widget_above_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:textColor="#C77C1E"
                    android:includeFontPadding="false"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/widget_above_suffix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="%"
                    android:textSize="13sp"
                    android:textColor="#C77C1E"
                    android:includeFontPadding="false"
                    android:layout_marginStart="1dp"
                    android:layout_marginBottom="2dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_above_delta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="over 13.9"
                android:textSize="10sp"
                android:textColor="#C2255C"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
